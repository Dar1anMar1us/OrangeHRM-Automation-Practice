{
  "name": "orangehrm-automation-practice",
  "version": "1.0.0",
  "description": "QA Automation practice",
  "main": "index.js",
  "scripts": {
    "cypress:open": "env-cmd --silent cypress open",
    "test": "env-cmd --silent cypress run -b electron --headless && npm run report:pdf",
    "report:merge": "mochawesome-merge cypress/reports/mochawesome/*.json > cypress/reports/mochawesome-report.json",
    "report:pdf": "node scripts/generate-pdf-report.js"
  },

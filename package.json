  },
  "homepage": "https://github.com/Dar1anMar1us/OrangeHRM-Automation-Practice#readme",
  "devDependencies": {
    "cypress": "^15.15.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "puppeteer": "^25.0.2"
  },
  "dependencies": {
    "env-cmd": "^11.0.0"
  }
